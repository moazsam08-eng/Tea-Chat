{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tea-chat",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-08",
  "vars": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "info"
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
